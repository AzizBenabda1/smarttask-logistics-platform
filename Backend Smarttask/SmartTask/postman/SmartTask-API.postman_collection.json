{
  "info": {
    "name": "SmartTask API",
    "description": "SmartTask User Management & Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9090" },
    { "key": "token", "value": "" },
    { "key": "managerToken", "value": "" }
  ],
  "item": [
    {
      "name": "1. Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@email.com\",\n  \"password\": \"Password123\",\n  \"phone\": \"+21612345678\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "2. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('token', json.token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@smarttask.com\",\n  \"password\": \"Admin123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "3. Get Me (Auth)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/me"
      }
    },
    {
      "name": "4. Get All Users (ADMIN)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "5. Create User (ADMIN)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Manager\",\n  \"lastName\": \"One\",\n  \"email\": \"manager@smarttask.com\",\n  \"password\": \"Manager123!\",\n  \"phone\": \"+21698765432\",\n  \"role\": \"MANAGER\",\n  \"active\": true\n}"
        },
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "6. Update User (ADMIN)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Manager\",\n  \"lastName\": \"Updated\",\n  \"email\": \"manager@smarttask.com\",\n  \"phone\": \"+21698765432\",\n  \"role\": \"MANAGER\",\n  \"active\": true\n}"
        },
        "url": "{{baseUrl}}/api/users/2"
      }
    },
    {
      "name": "7. Patch Status (ADMIN)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"active\": false\n}"
        },
        "url": "{{baseUrl}}/api/users/2/status"
      }
    },
    {
      "name": "8. Patch Role (ADMIN)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role\": \"OPERATOR\"\n}"
        },
        "url": "{{baseUrl}}/api/users/2/role"
      }
    },
    {
      "name": "9. Get Profile (Me)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users/me"
      }
    },
    {
      "name": "10. Change Password (Me)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"Admin123!\",\n  \"newPassword\": \"NewAdmin123!\",\n  \"confirmPassword\": \"NewAdmin123!\"\n}"
        },
        "url": "{{baseUrl}}/api/users/me/password"
      }
    },
    {
      "name": "11. Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/auth/logout"
      }
    },
    {
      "name": "12. Delete User (ADMIN)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/users/2"
      }
    },
    {
      "name": "13. Login Manager",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json.token) { pm.collectionVariables.set('managerToken', json.token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"manager@smarttask.com\",\n  \"password\": \"Manager123!\"\n}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "14. Get Manager Dashboard",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": "{{baseUrl}}/api/manager/dashboard"
      }
    },
    {
      "name": "15. Get All Tasks (MANAGER)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "16. Create Task (MANAGER)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{managerToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Livraison test Postman\",\n  \"clientId\": 6,\n  \"deliveryAddress\": \"10 Rue Test, Tunis\",\n  \"zone\": \"Tunis\",\n  \"deadline\": \"2026-08-20T18:00:00\",\n  \"priority\": \"HIGH\"\n}"
        },
        "url": "{{baseUrl}}/api/tasks"
      }
    },
    {
      "name": "17. Assign Driver to Task (MANAGER)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": "{{baseUrl}}/api/tasks/1/assign/3"
      }
    },
    {
      "name": "18. Get Manager Drivers",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": "{{baseUrl}}/api/manager/drivers"
      }
    },
    {
      "name": "19. Get Delays (MANAGER)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": "{{baseUrl}}/api/manager/delays"
      }
    },
    {
      "name": "20. Get Analytics (MANAGER)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": "{{baseUrl}}/api/manager/analytics"
      }
    },
    {
      "name": "21. Get AI Recommendations (MANAGER)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{managerToken}}" }],
        "url": "{{baseUrl}}/api/manager/ai/recommendations"
      }
    }
  ]
}
