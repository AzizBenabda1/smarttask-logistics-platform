# SmartTask AI microservice
ENVIRONMENT=development
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_PORT=8000

# Spring Boot (caller — not used directly by Python at startup)
SPRING_BOOT_URL=http://localhost:9090

# ML models directory (relative to project root)
MODEL_PATH=./app/models

# Model versions (updated after training)
DELAY_MODEL_VERSION=1.0.0
DELIVERY_TIME_MODEL_VERSION=1.0.0
PRIORITY_MODEL_VERSION=0.0.0

# Logging
LOG_LEVEL=INFO
